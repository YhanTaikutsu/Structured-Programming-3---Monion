public class Main 
{

    static class Student {
        String name;
        int[] quizzes;

        Student(String name, int[] quizzes) {
            this.name = name;
            this.quizzes = quizzes;
        }

        double getAverage() {
            int sum = 0;

            for (int i = 0; i < quizzes.length; i++) {
                sum += quizzes[i];
            }

            return (double) sum / quizzes.length;
        }
    }

    static int linearSearch(Student[] students, String target) {
        for (int i = 0; i < students.length; i++) {
            if (students[i].name.equalsIgnoreCase(target)) {
                return i + 1;
            }
        }

        return -1;
    }

    static void sortStudents(Student[] students) {
        for (int i = 0; i < students.length - 1; i++) {
            for (int j = 0; j < students.length - 1 - i; j++) {
                if (students[j].getAverage() < students[j + 1].getAverage()) {
                    Student temp = students[j];
                    students[j] = students[j + 1];
                    students[j + 1] = temp;
                }
            }
        }
    }

    public static void main(String[] args) {
        int[][] quizData = {
            {90, 85, 88, 92},
            {95, 90, 99, 94},
            {80, 85, 82, 83},
            {95, 90, 93, 94},
            {88, 87, 90, 85}
        };

        String[] names = {
            "Christian",
            "Monion",
            "Garcia",
            "Yesuh",
            "Johnelle"
        };

        Student[] students = new Student[names.length];

        for (int i = 0; i < students.length; i++) {
            students[i] = new Student(names[i], quizData[i]);
        }

        sortStudents(students);

        System.out.println("========== CLASS LEADERBOARD ==========");
        System.out.printf("%-8s %-12s %-12s%n", "RANK", "NAME", "AVERAGE");
        System.out.println("---------------------------------------");

        int rank = 1;

        for (int i = 0; i < students.length; i++) {
            if (i > 0 &&
                students[i].getAverage() != students[i - 1].getAverage()) {
                rank = i + 1;
            }

            System.out.printf("%-8d %-12s %-12.2f%n",
                rank, students[i].name, students[i].getAverage());
        }

        String target = "Yesuh";
        int foundRank = linearSearch(students, target);

        if (foundRank != -1) {
            double targetAverage = students[foundRank - 1].getAverage();
            int actualRank = 1;

            for (int i = 0; i < students.length; i++) {
                if (students[i].getAverage() > targetAverage) {
                    actualRank++;
                }
            }

            System.out.println("\n" + target + " is ranked #" + actualRank);
        } else {
            System.out.println("\n" + target + " was not found.");
        }
    }
}
