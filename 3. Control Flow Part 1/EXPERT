import java.util.Scanner;

public class Main 
{
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        String correctUsername = "MONION";
        int correctPIN = 6767;
        double balance = 25000.00;

        System.out.print("Enter username: ");
        String username = input.nextLine();

        if (username.equalsIgnoreCase(correctUsername)) {
            System.out.print("Enter 4-digit PIN: ");
            int pin = input.nextInt();

            if (pin == correctPIN) {
                System.out.println("Login successful!");

                String tier;
                double dailyLimit;

                if (balance < 10000) {
                    tier = "Bronze";
                    dailyLimit = 5000;
                } else if (balance < 20000) {
                    tier = "Silver";
                    dailyLimit = 10000;
                } else if (balance < 50000) {
                    tier = "Gold";
                    dailyLimit = 20000;
                } else {
                    tier = "Platinum";
                    dailyLimit = 50000;
                }

                System.out.println("Account Tier: " + tier);
                System.out.printf("Available Balance: %.2f%n", balance);
                System.out.printf("Daily Withdrawal Limit: %.2f%n", dailyLimit);

                System.out.print("Enter withdrawal amount: ");
                double amount = input.nextDouble();

                double feePercent;

                switch (tier) {
                    case "Bronze":
                        feePercent = 2.0;
                        break;
                    case "Silver":
                        feePercent = 1.5;
                        break;
                    case "Gold":
                        feePercent = 1.0;
                        break;
                    default:
                        feePercent = 0.5;
                }

                double fee = amount * feePercent / 100;
                double total = amount + fee;

                if (amount <= 0) {
                    System.out.println("DENIED: Amount must be greater than zero.");
                } else {
                    if (total <= balance && amount <= dailyLimit) {
                        System.out.println("APPROVED");
                        System.out.printf("Withdrawal Amount: %.2f%n", amount);
                        System.out.printf("Transaction Fee: %.2f%n", fee);
                        System.out.printf("Total Deducted: %.2f%n", total);

                        balance -= total;
                        System.out.printf("Remaining Balance: %.2f%n", balance);
                    } else {
                        if (total > balance) {
                            System.out.println("DENIED: Insufficient balance to cover withdrawal and fee.");
                        } else {
                            System.out.println("DENIED: Withdrawal exceeds your daily limit.");
                        }
                    }
                }

            } else {
                System.out.println("DENIED: Incorrect PIN.");
            }

        } else {
            System.out.println("DENIED: Incorrect username.");
        }

        input.close();
    }
}
