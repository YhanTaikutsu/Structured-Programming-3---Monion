public class Main 
{
    public static void main(String[] args) {
        int size = 7;

        for (int row = 1; row <= size; row++) {

            // CONTINUE: Skip row 3
            if (row == 3) {
                continue;
            }

            for (int col = 1; col <= row; col++) {

                // BREAK: Stop the inner loop when column reaches 4
                if (col == 4) {
                    break;
                }

                System.out.print("* ");
            }

            System.out.println();
        }
    }
}
